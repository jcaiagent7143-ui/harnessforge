#!/usr/bin/env bash
# test_task.sh — run one RAG question end-to-end against the project corpus.
# Generated by harness-kit; safe to edit if you also commit the change.
set -euo pipefail

if [ "${1:-}" = "" ]; then
  echo "usage: $0 \"<your question>\""
  exit 64
fi

QUESTION="$1"
OUT="${RAG_OUT:-/tmp/{{ profile.name }}-rag-output.json}"

echo "[rag] question: $QUESTION"
echo "[rag] writing answer to: $OUT"

# The actual retrieve + answer pipeline is the coding agent's job —
# this script just records inputs and runs the validator on the output.
# Your agent (Claude Code / Cursor / Codex / Gemini CLI / Aider /
# OpenHarness) should populate $OUT with:
#   {"answer": "...", "citations": [{"chunk_id": "..."}], "schema_version": 1}
#
# After it does, this script verifies.

if [ ! -f "$OUT" ]; then
  echo "[rag] expected $OUT after the agent runs. Skipping verify."
  exit 0
fi

harness verify --check citations --json
harness verify --check schema --json
