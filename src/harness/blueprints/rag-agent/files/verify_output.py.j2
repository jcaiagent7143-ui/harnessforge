"""verify_output.py — schema + citation re-check for one RAG answer.

Designed to run inside the aegis sandbox (no os, no subprocess). Reads a
JSON answer file and asserts:

  1. Answer JSON matches the declared Pydantic schema.
  2. Every claim sentence ends with a `[chunk_id]` token.
  3. Every cited chunk_id appears in the answer's `citations` list.

Returns a ``list[str]`` of failure messages — empty = pass.
"""
from __future__ import annotations

import json
import re
from typing import Any

# This file is rendered into the user's repo. Their agent calls it.
# The function name `verify` matches the contract used by aegis.synthesize.sandbox.

CITATION_RE = re.compile(r"\[([a-zA-Z0-9_-]{4,64})\]")


def verify(answer_json: str | dict[str, Any]) -> list[str]:
    """Return a list of human-readable failures. Empty list = pass."""
    failures: list[str] = []
    try:
        payload = answer_json if isinstance(answer_json, dict) else json.loads(answer_json)
    except (json.JSONDecodeError, TypeError) as e:
        return [f"answer is not valid JSON: {e}"]

    if not isinstance(payload, dict):
        return [f"answer must be a JSON object, got {type(payload).__name__}"]

    # 1. Schema
    if "answer" not in payload or not isinstance(payload["answer"], str):
        failures.append("missing or non-string 'answer' field")
    if "citations" not in payload or not isinstance(payload["citations"], list):
        failures.append("missing or non-list 'citations' field")
    if payload.get("schema_version") != 1:
        failures.append("schema_version must be 1")

    if failures:
        return failures

    # 2. Citation extraction
    cited_in_text = set(CITATION_RE.findall(payload["answer"]))
    listed = {c["chunk_id"] for c in payload["citations"] if isinstance(c, dict)}

    # 3. Cross-check
    missing_in_list = cited_in_text - listed
    missing_in_text = listed - cited_in_text
    for cid in sorted(missing_in_list):
        failures.append(f"chunk_id {cid!r} cited in text but not in citations[]")
    for cid in sorted(missing_in_text):
        failures.append(f"chunk_id {cid!r} listed in citations[] but never cited in text")

    # 4. Every sentence should have at least one citation if it contains a factual claim
    # (heuristic: sentences with a digit, proper noun, or quote)
    sentences = re.split(r"(?<=[.!?])\s+", payload["answer"].strip())
    for s in sentences:
        if not s or len(s) < 12:
            continue
        is_factual = bool(re.search(r"\d|[A-Z][a-z]{2,}|\"", s))
        if is_factual and not CITATION_RE.search(s):
            failures.append(f"sentence appears factual but has no [chunk_id]: {s[:80]!r}")
            break  # one example is enough

    return failures
