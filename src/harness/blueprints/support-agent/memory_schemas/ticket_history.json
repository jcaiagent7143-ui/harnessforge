{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-kit/support-agent/ticket-history",
  "title": "Support ticket record",
  "type": "object",
  "required": ["ticket_id", "conversation_id", "intent", "priority", "status", "lineage"],
  "properties": {
    "ticket_id": {"type": "string"},
    "conversation_id": {"type": "string"},
    "intent": {"enum": ["question", "bug", "feature", "billing", "other"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "sla_due_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["open", "escalated", "resolved"]},
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["turn", "message_id"],
        "properties": {
          "turn": {"type": "integer", "minimum": 0},
          "message_id": {"type": "string"}
        }
      }
    },
    "resolved_summary": {"type": "string"},
    "resolution_action": {"type": "string"}
  }
}
